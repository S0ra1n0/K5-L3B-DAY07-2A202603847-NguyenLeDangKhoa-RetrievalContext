# Copy to .env. Everything is local: no API key is needed.
# Postgres + pgvector from docker-compose.yml (local-only lab password, same as Day 6).
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab
CHUNK_SET=B
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DEVICE=cpu
# Local Ollama server and tool-calling model
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
